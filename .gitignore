# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
*.db
# Scripts operativos con credenciales escritas en claro. update-users.js lleva
# las contrasenas reales de las cuentas de produccion: si entra al historial de
# git, queda ahi para siempre aunque se borre el archivo despues. Se quedan en
# local a proposito.
scripts/update-users.js
scripts/reset-db.js
